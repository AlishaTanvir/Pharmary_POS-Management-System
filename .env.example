DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pharmacy_pos
# Used only by npm run local / db:local. Set to your own strong random password.
LOCAL_DB_PASSWORD=
PORT=3001
SESSION_MINUTES=30
# Required for initial user creation. No default password is supplied.
ADMIN_PASSWORD=
CASHIER_PASSWORD=
# Set true behind a TLS reverse proxy in production.
COOKIE_SECURE=false
# 32 random bytes as 64 hexadecimal characters; store an independent recovery copy.
BACKUP_KEY=
# Use a verified off-machine destination for real disaster recovery.
BACKUP_DIRECTORY=backups
BACKUP_OFF_DEVICE=false
# Optional full paths; Windows local preview also discovers .tools/pgsql/bin.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Fixed protected counter-local SQLite location; do not move/reset an active journal.
OFFLINE_DB_PATH=.local/counter.sqlite

# Clean production bootstrap only: no demo supplier, catalog or staff.
PHARMACY_NAME=
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
# Optional local supervisor control token; keep private.
LOCAL_CONTROL_TOKEN=
# Structured request logs omit query strings and request bodies.
REQUEST_LOGS=true
