{
  "name": "pharmacy-pos",
  "version": "0.26.0-dev.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "npm run check:access && tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "local": "tsx scripts/local.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:e2e": "playwright test",
    "db:bootstrap": "tsx server/bootstrap.ts",
    "package:windows": "tsx scripts/package-windows.ts",
    "test:load": "tsx scripts/load-check.ts",
    "access:generate": "tsx scripts/api-access.ts --write",
    "check:access": "tsx scripts/api-access.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "verify:release": "node scripts/windows/verify-release.mjs",
    "qualify:installed": "tsx scripts/qualify-installed.ts",
    "prepackage:windows": "npm run build",
    "pretest": "node scripts/check-test-storage.mjs 3",
    "pretest:acceptance": "node scripts/check-test-storage.mjs 1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
